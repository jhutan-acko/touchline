# Touchline environment variables. Copy to .env.local (git-ignored) and fill in what you need.
# Everything is optional: with nothing set, the agent service uses a deterministic stub model and makes no network calls.
# Read by services/agents/touchline_agents/config.py (environment first, then .env.local at the repo root).

# Model provider for the agent service: "stub" (default, offline, deterministic) or "openai".
TOUCHLINE_LLM=stub
# API key; required only when TOUCHLINE_LLM=openai. Never commit it.
OPENAI_API_KEY=
# Model for the "small" and "large" agent tiers (default gpt-6.1-sol for both).
TOUCHLINE_MODEL_SMALL=
TOUCHLINE_MODEL_LARGE=
# Model for the fast tier: pause-and-ask question parsing and personalising (default gpt-5.4-mini).
TOUCHLINE_MODEL_FAST=
# Reasoning effort: low (default), medium or high.
TOUCHLINE_REASONING=
# Multiplies every per-agent timeout (default 1); raise it (e.g. 6) for recorded runs with a real model.
TOUCHLINE_TIMEOUT_SCALE=
# Seconds one request may take before the remaining agents fall back to templates (live runs; default: no limit).
TOUCHLINE_REQUEST_BUDGET_S=
# Model price in USD per million tokens as "input,output"; only used to report cost in the manager A/B.
TOUCHLINE_PRICE_USD_PER_MTOK=
# Extra Host headers the MCP stats server accepts, comma separated (default 127.0.0.1,localhost,::1).
TOUCHLINE_MCP_HOSTS=
# Folder for agent workflow checkpoints (default: none).
TOUCHLINE_CHECKPOINTS=

# --- Test and tooling switches (not needed to run the app) ---
# Seeds for the stub model's deterministic variation and injected errors in tests/evals.
TOUCHLINE_AGENTS_SEED=
TOUCHLINE_AGENTS_ERROR_SEED=
# Set to any value to print Ask stage timings in the API tests.
TOUCHLINE_ASK_TIMINGS=
# Set to 1 to rewrite the realism baseline / golden files in tests.
UPDATE_REALISM_BASELINE=
UPDATE_STATS_GOLDEN=
UPDATE_GOLDEN=
